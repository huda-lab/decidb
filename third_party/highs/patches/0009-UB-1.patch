+// DeciDB patch (UB-1): a column bound as an integer, saturated at the integer range. An infinite bound is not
+// representable, and converting it is undefined; findLurkingBounds reads the other bound only when it is finite.
+static HighsInt boundAsInt(double bound) {
+  if (bound >= kHighsIInf) return kHighsIInf;
+  if (bound <= -kHighsIInf) return -kHighsIInf;
+  return static_cast<HighsInt>(bound);
+}
