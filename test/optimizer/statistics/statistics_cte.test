# name: test/optimizer/statistics/statistics_cte.test
# description: A reference to a materialized CTE takes the statistics and constants of the CTE's columns
# group: [statistics]

statement ok
PRAGMA enable_verification;

statement ok
PRAGMA explain_output = OPTIMIZED_ONLY;

statement ok
CREATE TABLE integers AS SELECT * FROM (VALUES (1), (2), (3)) tbl(i);

# the statistics of the CTE's column reach its reference: "i" holds no NULL
query II
EXPLAIN WITH t AS MATERIALIZED (SELECT i FROM integers) SELECT * FROM t WHERE i IS NULL;
----
logical_opt	<REGEX>:.*EMPTY_RESULT.*

query I
WITH t AS MATERIALIZED (SELECT i FROM integers) SELECT * FROM t WHERE i IS NULL;
----

# the columns are taken by position: "n" can hold NULL though the column before it cannot
query II
EXPLAIN WITH t AS MATERIALIZED (SELECT i, CASE WHEN i = 2 THEN NULL ELSE i END AS n FROM integers) SELECT i FROM t WHERE n IS NULL;
----
logical_opt	<!REGEX>:.*EMPTY_RESULT.*

query I
WITH t AS MATERIALIZED (SELECT i, CASE WHEN i = 2 THEN NULL ELSE i END AS n FROM integers) SELECT i FROM t WHERE n IS NULL;
----
2

# a CTE column that holds a constant is that constant in a computation at the reference; the columns are taken by
# position, so the constant is the second column's and not the first's
query II
EXPLAIN WITH t AS MATERIALIZED (SELECT i, 'a' AS c FROM integers) SELECT upper(c) || 'x' FROM t;
----
logical_opt	<!REGEX>:.*upper.*

query I
WITH t AS MATERIALIZED (SELECT i, 'a' AS c FROM integers) SELECT upper(c) || 'x' FROM t ORDER BY i;
----
Ax
Ax
Ax

query I
WITH t AS MATERIALIZED (SELECT i, 'a' AS c FROM integers) SELECT upper(i::VARCHAR) FROM t ORDER BY i;
----
1
2
3

# each reference takes them
query I
WITH t AS MATERIALIZED (SELECT i, 'a' AS c FROM integers) SELECT upper(x.c) || y.c FROM t x, t y WHERE x.i = y.i ORDER BY x.i;
----
Aa
Aa
Aa

# a reference to a recursive CTE takes nothing: its rows are not the rows of its first iteration
query I
WITH RECURSIVE r AS (SELECT 1 x UNION ALL SELECT x + 1 FROM r WHERE x < 3) SELECT * FROM r ORDER BY x;
----
1
2
3

query II
WITH RECURSIVE r(x, c) AS (SELECT 1, 'a' UNION ALL SELECT x + 1, 'b' FROM r WHERE x < 3) SELECT x, upper(c) FROM r ORDER BY x;
----
1	A
2	B
3	B

query I
WITH RECURSIVE r(x, c) AS (SELECT 1, 'a' UNION ALL SELECT x + 1, 'b' FROM r WHERE x < 3) SELECT x FROM r WHERE c IS NULL;
----
