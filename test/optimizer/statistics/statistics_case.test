# name: test/optimizer/statistics/statistics_case.test
# description: Test filter propagation in CASE expression
# group: [statistics]

statement ok
PRAGMA enable_verification;

statement ok
PRAGMA explain_output = OPTIMIZED_ONLY;

statement ok
CREATE TABLE integers AS SELECT * FROM (VALUES (1), (2), (3)) tbl(i);

# "i" does not contain null values, so we can statically determine this will not be null
query II
EXPLAIN SELECT * FROM integers WHERE (CASE WHEN i=2 THEN i+1 ELSE i+2 END) IS NULL;
----
logical_opt	<REGEX>:.*EMPTY_RESULT.*

# we can't here, because one of the children of the case has null
query II
EXPLAIN SELECT * FROM integers WHERE (CASE WHEN i=2 THEN i+1 ELSE NULL END) IS NULL;
----
logical_opt	<!REGEX>:.*EMPTY_RESULT.*

# now check overflow testing
# this gives an overflow on the RHS
statement error
SELECT 123::TINYINT + (CASE WHEN i=2 THEN (i+1)::TINYINT ELSE (i+2)::TINYINT END) FROM integers;
----
<REGEX>:Out of Range Error:.*Overflow in addition.*

# this does not
query I
SELECT 122::TINYINT + (CASE WHEN i=2 THEN (i+1)::TINYINT ELSE (i+2)::TINYINT END) FROM integers;
----
125
125
127

query I
SELECT * FROM integers WHERE (CASE WHEN i=2 THEN i+1 ELSE i+2 END) IS NULL;
----

query I
SELECT * FROM integers WHERE (CASE WHEN i=2 THEN i+1 ELSE NULL END) IS NULL;
----
1
3

# a check the statistics prove constant folds the CASE (the same fold CaseSimplificationRule makes of a written
# constant); "i" holds no NULL, so "i IS NULL" is false and "i IS NOT NULL" is true

# a check proved false is erased, and the check after it stays
query II
EXPLAIN SELECT CASE WHEN i IS NULL THEN 5 WHEN i=2 THEN 6 ELSE i+100 END FROM integers;
----
logical_opt	<REGEX>:.*CASE.*i = 2.*

query II
EXPLAIN SELECT CASE WHEN i IS NULL THEN 5 WHEN i=2 THEN 6 ELSE i+100 END FROM integers;
----
logical_opt	<!REGEX>:.*false.*

# a check proved true becomes the result when nothing precedes it
query II
EXPLAIN SELECT CASE WHEN i IS NOT NULL THEN i+7 ELSE 100 END FROM integers;
----
logical_opt	<!REGEX>:.*CASE.*

# a check proved true ends the checks: those after it are dropped and its result is the ELSE
query II
EXPLAIN SELECT CASE WHEN i=2 THEN 5 WHEN i IS NOT NULL THEN i+7 WHEN i=3 THEN 9 ELSE 100 END FROM integers;
----
logical_opt	<REGEX>:.*CASE.*i = 2.*i \+ 7.*

query II
EXPLAIN SELECT CASE WHEN i=2 THEN 5 WHEN i IS NOT NULL THEN i+7 WHEN i=3 THEN 9 ELSE 100 END FROM integers;
----
logical_opt	<!REGEX>:.*(100|\(9\)).*

# every check erased leaves the ELSE
query II
EXPLAIN SELECT CASE WHEN i IS NULL THEN 5 WHEN i IS NULL THEN 6 ELSE i+100 END FROM integers;
----
logical_opt	<!REGEX>:.*CASE.*

# a nested CASE folds before the one around it
query II
EXPLAIN SELECT CASE WHEN i=2 THEN 5 ELSE CASE WHEN i IS NULL THEN 6 ELSE i+100 END END FROM integers;
----
logical_opt	<!REGEX>:.*CASE.*CASE.*

# a check the statistics make constant that fails to evaluate stays, and raises only on the rows that reach it
query I
SELECT CASE WHEN i=1 THEN 0 WHEN abs((-2147483647 - 1)::INTEGER) > (i IS NULL)::INTEGER THEN 5 ELSE i+100 END FROM integers WHERE i=1;
----
0

statement error
SELECT CASE WHEN i=1 THEN 0 WHEN abs((-2147483647 - 1)::INTEGER) > (i IS NULL)::INTEGER THEN 5 ELSE i+100 END FROM integers;
----
<REGEX>:Out of Range Error:.*Overflow on abs.*

query I
SELECT CASE WHEN i IS NULL THEN 5 WHEN i=2 THEN 6 ELSE i+100 END FROM integers ORDER BY i;
----
101
6
103

query I
SELECT CASE WHEN i=2 THEN 5 WHEN i IS NOT NULL THEN i+7 WHEN i=3 THEN 9 ELSE 100 END FROM integers ORDER BY i;
----
8
5
10
