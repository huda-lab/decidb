# name: test/decidb/test_parser.test
# description: Test DecidB's Parser
# group: [decidb]

statement ok
ATTACH 'build/decidb.db' AS decidb;

statement ok
SET search_path = 'decidb,main';

# Parse REAL
statement ok
SELECT l_quantity FROM lineitem DECIDE x IS REAL SUCH THAT x <= 1 MAXIMIZE SUM(x*l_quantity) LIMIT 1;

# Parse INTEGER
statement ok
SELECT l_quantity FROM lineitem DECIDE x IS INTEGER SUCH THAT x <= 1 MAXIMIZE SUM(x*l_quantity) LIMIT 1;

# Parse BOOLEAN
statement ok
SELECT l_quantity FROM lineitem DECIDE x IS BOOLEAN SUCH THAT x <= 1 MAXIMIZE SUM(x*l_quantity) LIMIT 1;

# No SUCH THAT
statement error
SELECT l_quantity FROM lineitem DECIDE x MAXIMIZE SUM(x*l_quantity) LIMIT 1;
----
Parser Error: syntax error at or near "MAXIMIZE"

# No DECIDE variable
statement error
SELECT l_quantity FROM lineitem DECIDE SUCH THAT x <= 1 MAXIMIZE SUM(x*l_quantity) LIMIT 1;
----
Parser Error: syntax error at or near "SUCH"

# No objective
statement ok
SELECT l_quantity FROM lineitem DECIDE x IS BOOLEAN SUCH THAT x <= 1 LIMIT 1;

# Unknown variable type
statement error
SELECT l_quantity FROM lineitem DECIDE x IS CONTINUOUS SUCH THAT x <= 1 MAXIMIZE SUM(x*l_quantity) LIMIT 1;
----
Parser Error: syntax error at or near "CONTINUOUS"
